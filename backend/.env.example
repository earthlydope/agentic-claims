# ── Model provider ────────────────────────────────────────────────────────
# Either an AI Studio key…
GOOGLE_API_KEY=
# …or Vertex AI with application-default credentials:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=europe-west4

# Model routing: a fast tier for routine steps, a more capable tier for the hard ones.
# A Pro tier needs Pro quota on the project; set MODEL_CAPABLE to it when you have it.
MODEL_FAST=gemini-3.6-flash
MODEL_CAPABLE=gemini-3.7-flash

# ── Autonomy thresholds (Allianz owns these values) ──────────────────────
AUTO_APPROVAL_CEILING_EUR=2500.00

# ── Pillar 3 signing ─────────────────────────────────────────────────────
# Leave CLOUD_KMS_KEY_NAME empty to sign with local HMAC (demo).
# Set it to a KMS key resource name to sign through Cloud KMS + workload identity.
ZERO_TRUST_SECRET_KEY=change-me-in-any-real-environment
CLOUD_KMS_KEY_NAME=

# ── Platform ─────────────────────────────────────────────────────────────
TENANT=allianz-at
REGION=europe-west4
DB_PATH=claims.db
