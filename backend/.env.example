# ── Model provider ────────────────────────────────────────────────────────
# Either an AI Studio key…
GOOGLE_API_KEY=
# …or Vertex AI with application-default credentials:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=europe-west4

# Model routing: a fast tier for routine steps, a more capable tier for the hard ones.
# A Pro tier needs Pro quota on the project; set MODEL_CAPABLE to it when you have it.
MODEL_FAST=gemini-3.1-flash-lite
MODEL_CAPABLE=gemini-3.1-flash-lite

# ── Second source (optional but recommended) ─────────────────────────────
# One project's quota is a single ceiling. With an OpenRouter key present as well, the
# platform tries Gemini first and falls through to OpenRouter on a quota refusal, so a
# run continues rather than stopping. MODEL_PROVIDER: auto | google | openrouter | fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=dots-studio/dots-3-note-preview:free
OPENROUTER_MODEL_CAPABLE=minimax/minimax-m3:free
MODEL_PROVIDER=auto

# Requests per minute the limiter allows, per provider.
MODEL_MAX_RPM=15
OPENROUTER_MAX_RPM=20

# OpenRouter's free models are an order of magnitude slower than Gemini's, so give a run
# room rather than killing one that is working.
RUN_WALL_CLOCK_SECONDS=900

# ── Autonomy thresholds (Allianz owns these values) ──────────────────────
AUTO_APPROVAL_CEILING_EUR=2500.00

# ── Pillar 3 signing ─────────────────────────────────────────────────────
# Leave CLOUD_KMS_KEY_NAME empty to sign with local HMAC (demo).
# Set it to a KMS key resource name to sign through Cloud KMS + workload identity.
ZERO_TRUST_SECRET_KEY=change-me-in-any-real-environment
CLOUD_KMS_KEY_NAME=

# ── Platform ─────────────────────────────────────────────────────────────
TENANT=allianz-at
REGION=europe-west4
DB_PATH=claims.db

# ── Deployed console (Vercel) ────────────────────────────────────────────
# Comma-separated exact origins. Preview URLs are also allowed via regex.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
